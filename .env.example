# Provider keys stay server-side only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Optional: comma-separated Gemini key pool.
GOOGLE_API_KEYS=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# Optional payment wiring for the next phase.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Leave true for local demos without paid provider calls.
MAGI_MOCK_MODE=true

# Set true in production after auth + Stripe credit ledger are connected.
MAGI_REQUIRE_BILLING=false
