# Provider keys stay server-side only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Optional: comma-separated Gemini key pool.
GOOGLE_API_KEYS=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# Optional payment wiring for the next phase.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
NEXT_PUBLIC_APP_URL=

# Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional Streamable HTTP MCP servers. Context7 works in Vercel and gives
# MAGI current framework/library docs for coding prompts.
# MCP_SERVERS_JSON=[{"name":"Context7","url":"https://mcp.context7.com/mcp","enabled":true}]
# Add a hosted 21st.dev Magic bridge beside Context7:
# MCP_SERVERS_JSON=[{"name":"Context7","url":"https://mcp.context7.com/mcp","enabled":true},{"name":"21st.dev Magic","url":"https://YOUR-BRIDGE-HOST/mcp","enabled":true,"headers":{"Authorization":"Bearer YOUR_BRIDGE_TOKEN"}}]
MCP_SERVERS_JSON=

# Leave true for local demos without paid provider calls.
MAGI_MOCK_MODE=true

# Set true in production after auth + Stripe credit ledger are connected.
MAGI_REQUIRE_BILLING=false
MAGI_FREE_CREDITS=5
MAGI_RUN_RATE_LIMIT=30
MAGI_ARTIFACT_RATE_LIMIT=20
